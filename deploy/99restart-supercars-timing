// Restart the supercars-timing user service if a .NET upgrade deleted files it is running on.
// Source: ~/Dev/supercars-timing/deploy/ (see restart-after-dotnet-upgrade.sh for why and how to install).
DPkg::Post-Invoke { "[ -x /usr/local/sbin/restart-supercars-after-dotnet-upgrade ] && /usr/local/sbin/restart-supercars-after-dotnet-upgrade || true"; };
